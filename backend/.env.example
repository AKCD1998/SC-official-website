PORT=3000
CORS_ORIGIN=http://localhost:5173,https://your-frontend-host.example
SC_OFFICIAL_SUPABASE_DATABASE_URL=<SC_OFFICIAL_WEBSITE_DATABASE_URL>
# Legacy fallbacks only. Prefer SC_OFFICIAL_SUPABASE_DATABASE_URL in shared backend deployments.
SC_OFFICIAL_DATABASE_URL=
DATABASE_URL=
SEAMLESS_DB_SCHEMA=clasp_scx_seamless
INTERNAL_API_TOKEN=
# Prefer this over the bare INTERNAL_API_TOKEN above once other modules start needing their
# own token — bare INTERNAL_API_TOKEN is only safe to share because nothing else uses it today.
SEAMLESS_INTERNAL_API_TOKEN=
# HTTP Basic Auth for the seamless module's own app-facing routes only (/api/app/*,
# /api/files/*, /api/workbooks/*, /api/bootstrap) — NOT the whole shared backend. When either
# is empty those routes are open with no auth (dev-only fallback). Bearer
# SEAMLESS_INTERNAL_API_TOKEN / INTERNAL_API_TOKEN above also satisfies this check, so
# print-agent needs no separate token. Accepts a comma-separated list of usernames sharing one
# password (e.g. multiple staff accounts) — SEAMLESS_APP_BASIC_USER=staff000,staff001,staff002
SEAMLESS_APP_BASIC_USER=
SEAMLESS_APP_BASIC_PASSWORD=
# Optional second credential pair for admin-level access to the same routes — an admin session
# sees classification diagnostics and a few extra PharmCare Inbox columns (route, document
# number, review status) that a regular SEAMLESS_APP_BASIC_USER session does not. Leave empty to
# skip the admin tier entirely (everyone who can log in gets the regular-user view).
SEAMLESS_APP_ADMIN_BASIC_USER=
SEAMLESS_APP_ADMIN_BASIC_PASSWORD=
# Signs the login session cookie (/api/app/session/login) so the client doesn't rely on the
# browser's native Basic Auth popup, which only attaches to same-context fetch calls, not plain
# link navigations like the history table's file-download links. Falls back to
# SEAMLESS_INTERNAL_API_TOKEN / INTERNAL_API_TOKEN, then SEAMLESS_APP_BASIC_PASSWORD, if unset —
# set explicitly for cleaner secret separation.
SEAMLESS_SESSION_SECRET=
# How many days a login session cookie stays valid before requiring login again. Defaults to 7.
SEAMLESS_SESSION_DAYS=
# ISO date; the print-agent auto-prints only processing_records uploaded on/after this date.
SEAMLESS_AUTO_PRINT_SINCE=
# LINE Messaging API channel dedicated to the seamless auto-print notification — a different
# channel/bot than REACTNJOB_LINE_* or SCGLAMLIFF_LINE_* above.
SEAMLESS_LINE_CHANNEL_ACCESS_TOKEN=
SEAMLESS_LINE_CHANNEL_SECRET=
SEAMLESS_LINE_TARGET_ID=
# Cloudflare R2 for generated .xlsx/preview workbooks — deliberately separate from the R2_*
# vars above (those are dedicated to slider image uploads and have no key-prefix isolation or
# download/presign support, which this module needs). Leave blank to use local disk fallback.
SEAMLESS_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
SEAMLESS_R2_ACCESS_KEY_ID=
SEAMLESS_R2_SECRET_ACCESS_KEY=
SEAMLESS_R2_BUCKET=
# Optional dedicated bucket for Shopee source, processed, and preview workbooks.
# Leave blank to use SEAMLESS_R2_BUCKET.
SHOPEE_R2_BUCKET=
SEAMLESS_R2_KEY_PREFIX=clasp-scx-seamless
SEAMLESS_STORAGE_DIR=storage/seamless
# External URL used to build file download links (e.g. this backend's own Render URL).
SEAMLESS_PUBLIC_BASE_URL=
# Gmail OAuth for the read-only PharmCare sync and live Shopee email report. Shopee reuses this
# credential because both features read admin@scgroup1989.com's mailbox; it never gets a write
# scope. The optional Shopee query override must remain scoped to the approved sender.
SEAMLESS_PHARMCARE_GMAIL_MAILBOX=admin@scgroup1989.com
SEAMLESS_PHARMCARE_GMAIL_AUTH_MODE=
SEAMLESS_PHARMCARE_GMAIL_CLIENT_ID=
SEAMLESS_PHARMCARE_GMAIL_CLIENT_SECRET=
SEAMLESS_PHARMCARE_GMAIL_REFRESH_TOKEN=
SEAMLESS_SHOPEE_GMAIL_QUERY=from:info@mail.shopee.co.th
# Recipient used by POST /api/files/:id/send-email when the request doesn't specify one.
SEAMLESS_DOCS_RECIPIENT_EMAIL=
JWT_SECRET=change-me
OTP_SECRET=change-me
OTP_TTL_MINUTES=10
EMAIL_PROVIDER=sendgrid
BREVO_API_KEY=
SENDGRID_API_KEY=<SHARED_WEBSITE_SENDGRID_API_KEY>
MAIL_USER=verified_sender@example.com
MAIL_FROM=verified_sender@example.com
DOCS_RECIPIENT_EMAIL=
MAIL_TO=receiver@example.com

# SCCRM
SCCRM_ACCESS_JWT_SECRET=change-me
SCCRM_REFRESH_TOKEN_SECRET=change-me
SCCRM_STAFF_PIN=123456
SCCRM_LINE_CHANNEL_ID=
SCCRM_LINE_CHANNEL_SECRET=
SCCRM_LINE_REDIRECT_URI=
SCCRM_GOOGLE_CLIENT_ID=
SCCRM_GOOGLE_CLIENT_SECRET=
SCCRM_GOOGLE_REDIRECT_URI=
SCCRM_ALLOWED_STAFF_DEVICE_NAMES=

# Homepage slider admin — comma-separated emails allowed to change slider images
SITE_ADMIN_EMAILS=your-admin@example.com

# Cloudflare R2 — shared storage for slider image uploads
# (Reused from the cancelled scGlamLiff OCR project. The old SCGLAMLIFF_R2_* vars remain
#  for backward compatibility — these generic R2_* vars are a clean parallel set.)
# Leave blank to use local disk fallback (development only; not persistent on Render free tier).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
R2_BUCKET=<bucket-name>
R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# ReactNJob module
# Use a separate SendGrid key so this module cannot share the website SendGrid key by accident.
REACTNJOB_SUBMIT_URL=https://script.google.com/macros/s/YOUR_SUBMIT_SCRIPT_ID/exec
REACTNJOB_QUICK_CV_SUBMIT_URL=https://script.google.com/macros/s/YOUR_QUICK_CV_SCRIPT_ID/exec
REACTNJOB_SENDGRID_API_KEY=<REACTNJOB_SENDGRID_API_KEY>
REACTNJOB_FROM_EMAIL=verified_reactnjob_sender@example.com
REACTNJOB_HR_EMAIL=hr@example.com
REACTNJOB_LINE_CHANNEL_SECRET=change-me
REACTNJOB_LINE_CHANNEL_ACCESS_TOKEN=change-me
REACTNJOB_LINE_NOTIFY_MODE=multicast
REACTNJOB_LINE_NOTIFY_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REACTNJOB_LINE_NOTIFY_ADMIN_URL=

# Rx1011 module
# Required in the shared service; RX1011 does not fall back to DATABASE_URL.
RX1011_DATABASE_URL=<RX1011_DATABASE_URL>
RX1011_JWT_SECRET=change-me
RX1011_PATIENTS_CSV_PATH=
ADMIN_SQL_EXECUTOR_MAX_SQL_LENGTH=20000
ADMIN_SQL_EXECUTOR_TIMEOUT_MS=5000
ADMIN_SQL_EXECUTOR_ROW_CAP=200
ADMIN_TABLE_BROWSER_ROW_CAP=500

# DigitalPJK module
# These names are intentionally project-scoped so DigitalPJK cannot use the shared website DATABASE_URL/JWT_SECRET by accident.
DIGITALPJK_DATABASE_URL=<DIGITALPJK_DATABASE_URL>
DIGITALPJK_JWT_SECRET=change-me
DIGITALPJK_JWT_EXPIRES_IN=1h
DIGITALPJK_CEO_NAME_TH=
DIGITALPJK_LOGIN_RATE_LIMIT_WINDOW_MS=60000
DIGITALPJK_LOGIN_RATE_LIMIT_MAX=5
DIGITALPJK_PDF_WRITE_SAMPLE=false
DIGITALPJK_PDF_SAMPLE_DIR=
DIGITALPJK_SC_SHIFT_INTEGRATION_KEY=change-me-sc-shift

# scGlamLiff module
# These names are intentionally project-scoped so scGlamLiff cannot use the shared website DATABASE_URL/JWT_SECRET by accident.
SCGLAMLIFF_ADMIN_DISPLAY_NAME=
SCGLAMLIFF_ADMIN_PASSWORD=
SCGLAMLIFF_ADMIN_USERNAME=
SCGLAMLIFF_BASE_URL=
SCGLAMLIFF_COOKIE_SAMESITE=
SCGLAMLIFF_COOKIE_SECURE=
SCGLAMLIFF_DATABASE_URL=
SCGLAMLIFF_FRONTEND_ORIGINS=
SCGLAMLIFF_GAS_APPOINTMENTS_URL=
SCGLAMLIFF_GAS_SECRET=
SCGLAMLIFF_JWT_SECRET=
SCGLAMLIFF_LINE_CHANNEL_ID=
SCGLAMLIFF_LINE_CHANNEL_SECRET=
SCGLAMLIFF_NODE_ENV=
SCGLAMLIFF_OMISE_SECRET_KEY=
SCGLAMLIFF_PORT=
SCGLAMLIFF_R2_ACCESS_KEY_ID=
SCGLAMLIFF_R2_BUCKET=
SCGLAMLIFF_R2_ENDPOINT=
SCGLAMLIFF_R2_KEY_PREFIX=
SCGLAMLIFF_R2_SECRET_ACCESS_KEY=
SCGLAMLIFF_RECEIPT_UPLOAD_STORAGE_DIR=
SCGLAMLIFF_SEED_DISPLAY_NAME=
SCGLAMLIFF_SEED_PASSWORD=
SCGLAMLIFF_SEED_ROLE=
SCGLAMLIFF_SEED_USERNAME=
